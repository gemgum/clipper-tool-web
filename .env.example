# Salin ke .env bila ingin mengisi tangan. .env di-gitignore.
# Biasanya tidak perlu: kunci & mesin diisi lewat Settings di aplikasi, dan
# engine menuliskannya sendiri ke berkas ini.

# Mesin AI (isi yang dipakai saja)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# Crawl berita terkini (notes/45): Serper utama, SociaVault cadangan
SERPER_API_KEY=
SOCIAVAULT_API_KEY=

# Versi web (serve -web): sandi bersama, atau SSO OIDC
# CLIPPER_PASSWORD=
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Opsional: timpa lokasi (bawaan terdeteksi otomatis)
# CLIPPER_DATA_DIR=./data
# CLIPPER_MODELS_DIR=./models
# CLIPPER_TOOLS_DIR=./bin
# CLIPPER_FONTS_DIR=./assets/fonts
# CLIPPER_CHROME=/path/ke/chrome
# CLIPPER_FFMPEG_BIN=ffmpeg
# CLIPPER_WHISPER_BIN=./bin/whisper-cli
# CLIPPER_WHISPER_MODEL=./models/ggml-small.bin
